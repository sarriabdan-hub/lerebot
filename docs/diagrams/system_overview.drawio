<mxfile host="app.diagrams.net" type="device">
  <diagram id="overview" name="System Overview">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="goal" value="Sorting goal&#10;(natural language)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="planner" value="High-Level Planner (VLM)&#10;grounds color &#8594; position" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="250" y="175" width="190" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="exec" value="&#960;0.5 VLA Executor&#10;(low-level policy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="520" y="175" width="190" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="arm" value="SO-101 Arm&#10;(6-DOF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="790" y="180" width="140" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cams" value="Cameras&#10;top / wrist / side" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="520" y="340" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="env" value="Environment&#10;racks + bin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="790" y="345" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="g1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="goal" target="planner"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g2" value="atomic command&#10;(source &#8594; destination)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="planner" target="exec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g3" value="actions &#183; 30 Hz" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="exec" target="arm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g4" value="observations" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="cams" target="exec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g5" value="manipulates" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="arm" target="env"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g6" value="observed by" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="env" target="cams"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
